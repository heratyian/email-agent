# Model credentials (only the provider selected by an account's agent is required)
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Example IMAP credentials. Use the environment-variable names generated in
# your private accounts.yaml file.
SUPPORT_EXAMPLE_COM_USERNAME=support@example.com
SUPPORT_EXAMPLE_COM_PASSWORD=

EMAIL_AGENT_DATABASE=data/email_agent.db

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<langsmith-api-key>
LANGSMITH_PROJECT="email-agent"
# Get this UUID with scripts/langsmith_application_tag_value_id.py.
LANGSMITH_APPLICATION_TAG_VALUE_ID=
